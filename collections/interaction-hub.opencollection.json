{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Interaction Hub API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Content",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/hub/v1/content",
            "params": [
              {
                "name": "category",
                "value": "example_value",
                "type": "query",
                "description": "Content category filter"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve portal content items."
        },
        {
          "info": {
            "name": "PeopleSoft Create Content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}:{port}/psft/api/hub/v1/content",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a new portal content item."
        }
      ]
    },
    {
      "info": {
        "name": "Branding",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Themes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/hub/v1/branding/themes",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve available branding themes."
        }
      ]
    }
  ],
  "bundled": true
}