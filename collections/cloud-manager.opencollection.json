{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Cloud Manager API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/cloudmgr/v1/environments",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve a list of provisioned PeopleSoft environments."
        },
        {
          "info": {
            "name": "PeopleSoft Provision Environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}:{port}/psft/api/cloudmgr/v1/environments",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Provision a new PeopleSoft environment on OCI from a template."
        }
      ]
    },
    {
      "info": {
        "name": "Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/cloudmgr/v1/templates",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve available provisioning templates."
        }
      ]
    }
  ],
  "bundled": true
}