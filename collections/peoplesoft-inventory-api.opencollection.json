{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Application Services Framework Accounts Payable Inventory API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Inventory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Inventory Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/asf/v1/inventory/items",
            "params": [
              {
                "name": "businessUnit",
                "value": "example_value",
                "type": "query",
                "description": "Business unit filter"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve inventory items and stock levels."
        }
      ]
    }
  ],
  "bundled": true
}