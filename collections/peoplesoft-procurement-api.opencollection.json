{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Application Services Framework Accounts Payable Procurement API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Procurement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Requisitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/asf/v1/procurement/requisitions",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve procurement requisitions."
        },
        {
          "info": {
            "name": "PeopleSoft List Purchase Orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/asf/v1/procurement/purchase-orders",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve purchase orders."
        }
      ]
    }
  ],
  "bundled": true
}