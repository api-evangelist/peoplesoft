{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Application Services Framework Accounts Payable Budgets API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Budgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Budgets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/asf/v1/budgets",
            "params": [
              {
                "name": "fiscalYear",
                "value": "example_value",
                "type": "query",
                "description": "Fiscal year filter"
              },
              {
                "name": "businessUnit",
                "value": "example_value",
                "type": "query",
                "description": "Business unit filter"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve budget definitions and data."
        }
      ]
    }
  ],
  "bundled": true
}