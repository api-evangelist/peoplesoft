{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Application Services Framework Accounts Payable Cases API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Cases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Cases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/asf/v1/cases",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve support and service cases."
        },
        {
          "info": {
            "name": "PeopleSoft Create Case",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}:{port}/psft/asf/v1/cases",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a new support or service case."
        }
      ]
    }
  ],
  "bundled": true
}