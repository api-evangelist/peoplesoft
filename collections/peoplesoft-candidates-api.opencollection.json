{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Application Services Framework Accounts Payable Candidates API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Candidates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft Submit Application",
            "type": "http"
          },
          "http": {
            "method": "POST",
