{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeopleSoft Enterprise Performance Management API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Budgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Budgets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/epm/v1/budgets",
            "params": [
              {
                "name": "fiscalYear",
                "value": "example_value",
                "type": "query",
                "description": "Fiscal year filter"
              },
              {
                "name": "businessUnit",
                "value": "example_value",
                "type": "query",
                "description": "Business unit filter"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve budget definitions and data."
        }
      ]
    },
    {
      "info": {
        "name": "Forecasts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Forecasts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/epm/v1/forecasts",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve forecast data and projections."
        }
      ]
    },
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PeopleSoft List Analytics Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:{port}/psft/api/epm/v1/analytics/reports",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve performance analytics reports."
        }
      ]
    }
  ],
  "bundled": true
}